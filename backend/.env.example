# Template for local env — copy to .env and fill in real values.
# Committed to VCS; never put real secrets here.

# 한국투자증권 오픈API — timeline(지표 바), heatmap(단물 지도) 공용
KIS_APP_KEY=
KIS_APP_SECRET=
# 실전투자: https://openapi.koreainvestment.com:9443
# 모의투자: https://openapivts.koreainvestment.com:29443
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# 히트맵 수집: 기존 KIS 키/토큰 재사용. 브라우저에서 KIS를 직접 호출하지 않음.
HEATMAP_ENABLED=true
HEATMAP_REQUESTS_PER_SECOND=5
# 특별 개장/마감시간을 KRX 공지 기준으로 지정하는 JSON. 기본은 09:00~15:30(한국 시간).
HEATMAP_SESSION_OVERRIDES={}

# FRED(미국 연준 경제 데이터) API — calendar 도메인에서 사용 예정
FRED_API_KEY=

# 네이버 검색 API(뉴스) — timeline 도메인(주요 뉴스)에서 사용
# 네이버 클라우드 플랫폼(NCP)에서 발급받은 키 — developers.naver.com 쪽 키와는 다름
# 호출: https://naverapihub.apigw.ntruss.com/search/v1/news
# 헤더: X-NCP-APIGW-API-KEY-ID(=NAVER_API_KEY_ID) / X-NCP-APIGW-API-KEY(=NAVER_API_KEY)
NAVER_API_KEY_ID=
NAVER_API_KEY=

# 제미나이 API — 브리핑·주린이 해설 생성(timeline), 일정 중요도 판단(calendar)에서 사용
GEMINI_API_KEY=

# Supabase Postgres 연결 문자열 — 전체 공용, Supabase 대시보드 > Project Settings > Database > Connection string 에서 확인
# 주의: Supabase가 기본으로 주는 문자열은 "postgresql://..."로 시작함 — SQLAlchemy 비동기(asyncpg)로
# 쓰려면 앞부분을 "postgresql+asyncpg://..."로 바꿔서 넣을 것
DATABASE_URL=

# Cloudflare Workers AI — timeline 보고서 이미지 생성
# 대시보드 계정 홈 URL의 계정 ID / 내 프로필 > API 토큰 > "Workers AI" 템플릿으로 발급
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Supabase Storage — timeline 보고서 이미지 업로드
# Project Settings > Data API > Project URL / Project Settings > API Keys > Secret key(또는 Legacy service_role)
# 서비스 키는 DB 전체 권한 — 서버 .env에만 둘 것
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
